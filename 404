<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 — Halaman Tidak Ditemukan | Nafil Fadillah</title>
    <meta name="robots" content="noindex">

    <link rel="icon" type="image/svg+xml" href="favicon.svg">
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        .error-page{
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 40px 20px;
        }
        .error-code{
            font-family: var(--font-mono);
            font-size: 5rem;
            font-weight: 700;
            color: var(--signal);
            line-height: 1;
            margin-bottom: 16px;
        }
        .error-msg{
            font-family: var(--font-mono);
            color: var(--muted);
            font-size: .95rem;
            margin-bottom: 32px;
        }
        .error-msg::before{ content: "$ "; color: var(--muted-2); }
    </style>
</head>
<body>
    <div class="error-page">
        <div class="error-code">404</div>
        <p class="error-msg">cat: halaman-ini: No such file or directory</p>
        <a href="index.html" class="btn btn-primary"><i class="fas fa-house"></i> Kembali ke Home</a>
    </div>
</body>
</html>
